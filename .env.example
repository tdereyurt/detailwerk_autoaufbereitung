# Stabile öffentliche URL nach dem ersten Deployment, ohne abschließenden Schrägstrich.
# Ohne Wert nutzt Cloudflare Pages vorläufig CF_PAGES_URL.
NEXT_PUBLIC_SITE_URL=

# Erst nach geprüften Unternehmensangaben und Rechtstexten auf true setzen.
NEXT_PUBLIC_SITE_READY=false

# Optional: Endpunkt eines eingerichteten Formspree-Formulars
# Ohne Endpunkt öffnet das Formular eine vorbereitete E-Mail im E-Mail-Programm
NEXT_PUBLIC_FORMSPREE_ENDPOINT=
